{
  "name": "bored-guess-the-movie",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "api:start": "node --env-file=.env --import tsx backend/dev-server.ts",
    "api:check": "tsc -p backend/tsconfig.json",
    "api:deploy": "npx wrangler@4 deploy --config backend/wrangler.jsonc",
    "build": "ng build",
    "test": "tsx --test tests/recommendation.test.ts tests/game-state.test.ts tests/watch-links.test.ts tests/api.test.ts tests/online-movies.test.ts tests/questionnaire-matrix.test.ts",
    "test:live": "tsx scripts/test-live-options.mts"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/router": "^18.2.0",
    "rxjs": "~7.8.1",
    "tesseract.js": "^6.0.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.5.4"
  }
}
